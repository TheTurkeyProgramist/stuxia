# Cloudflare Pages: заголовки (аналог блоку "headers" з vercel.json)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Стихію не можна відкривати у фреймі на інших сайтах (і саму в себе)
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  # Браузер не вгадує тип файлу, а чужим сайтам іде лише домен, без повної адреси
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
